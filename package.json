{
  "name": "prompt-studio",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "node --use-system-ca --env-file-if-exists=.env.local scripts/studio.ts",
    "dev": "node --use-system-ca node_modules/next/dist/bin/next dev -H 127.0.0.1",
    "build": "node --use-system-ca node_modules/next/dist/bin/next build",
    "start": "node --use-system-ca node_modules/next/dist/bin/next start -H 127.0.0.1",
    "typecheck": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
